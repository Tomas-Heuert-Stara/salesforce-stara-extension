{
  "manifest_version": 3,
  "name": "Stara SF Toolbox",
  "version": "0.2.0",
  "description": "Side panel for Salesforce: live deployment status, Apex job KPIs and Setup shortcuts for the org you are logged into.",
  "minimum_chrome_version": "116",
  "permissions": [
    "cookies",
    "storage",
    "clipboardWrite"
  ],
  "options_ui": {
    "page": "src/options.html",
    "open_in_tab": true
  },
  "host_permissions": [
    "https://*.salesforce.com/*",
    "https://*.force.com/*",
    "https://*.salesforce-setup.com/*",
    "https://*.cloudforce.com/*",
    "https://*.visualforce.com/*",
    "https://raw.githubusercontent.com/*"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.salesforce.com/*",
        "https://*.force.com/*",
        "https://*.salesforce-setup.com/*",
        "https://*.cloudforce.com/*",
        "https://*.visualforce.com/*"
      ],
      "js": ["src/content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["src/panel.html"],
      "matches": [
        "https://*.salesforce.com/*",
        "https://*.force.com/*",
        "https://*.salesforce-setup.com/*",
        "https://*.cloudforce.com/*",
        "https://*.visualforce.com/*"
      ]
    }
  ],
  "action": {
    "default_title": "Toggle Stara SF Toolbox",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "toggle-panel": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Toggle the Stara SF Toolbox panel"
    }
  }
}
